# Seguridad
SECRET_KEY=tu_clave_secreta_aqui

# Configuración de Mail (Gmail App Password)
MAIL_USERNAME=tu_email@gmail.com
MAIL_PASSWORD=tu_app_password_aqui
MAIL_DEFAULT_SENDER=tu_email@gmail.com

# Entorno
FLASK_DEBUG=False
PORT=5000

# Admin: para editar fichas técnicas hay que iniciar sesión con este email
FICHA_EDITOR_EMAIL=indelfrix.ventas@gmail.com
ADMIN_USER=admin
# Generar con: python hash_password.py "tu_contraseña"
ADMIN_PASS=scrypt:...
FLASK_SECRET=una_clave_secreta_larga

# Cloudinary. Preferí CLOUDINARY_URL; no subas secretos al repositorio.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pedidos de clientes (Google OAuth). En Google Cloud Console:
# URIs autorizados: http://127.0.0.1:5000/login/google/callback
# y https://TU-DOMINIO/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Destinatario interno de los pedidos (mail)
PEDIDOS_MAIL_TO=indelfrix.ventas@gmail.com

# WhatsApp Cloud API (Meta). El emisor es el número de la empresa en Meta;
# el destinatario debe ser el WhatsApp que lee ventas (no suele funcionar
# enviarse a sí mismo el mismo phone_number_id).
# WHATSAPP_DESTINO en formato internacional sin + ni 0, ej: 5491144471684
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DESTINO=5491144471684
# Opcional: plantilla aprobada si Meta bloquea mensajes de texto libres
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es_AR
